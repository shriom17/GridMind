ence engine (TTA + TTT + symbolic-first)","metadata":{}},{"id":"bf7bd5ba","cell_type":"code","source":"# 9. Inference engine: test-time augmentation (TTA) + test-time training (TTT) + symbolic-first policy\nttt_model = GridMindV5(CFG).to(device)\n\n\n@torch.no_grad()\ndef run_model(m, episodes, bs=8):\n    m.eval()\n    probs, nh, nw = [], [], []\n    for i in range(0, len(episodes), bs):\n        b = collate([episode_tensors(*e) for e in episodes[i:i + bs]])\n        with torch.autocast(device_type=device.type, dtype=torch.float16, enabled=AMP):\n            out = m(b[\"support_inputs\"].to(device), b[\"support_outputs\"].to(device),\n                    b[\"query_input\"].to(device), b[\"support_mask\"].to(device))\n        probs.append(F.softmax(out[\"logits\"][-1].float(), 1).cpu().numpy())\n        nh.append(out[\"height_logits\"].argmax(1).cpu().numpy() + 1)\n        nw.append(out[\"width_logits\"].argmax(1).cpu().numpy() + 1)\n    return np.concatenate(probs), np.concatenate(nh), np.concatenate(nw)\n\n\ndef make_tta_augs(n_perms, seed=SEED):\n    rng = random.Random(seed)\n    augs = [IDENTITY_AUG]\n    for k in range(4):\n        for flip in (False, True):\n            for j in range(n_perms):\n                if k == 0 and not flip and j == 0:\n                    continue                                   # identity already added\n                perm = np.arange(10) if j == 0 else np.array([0] + rng.sample(range(1, 10), 9))\n                augs.append((k, flip, perm))\n    return augs\n\n\ndef predict_item(m, item, augs):\n    \"\"\"Average the model's probabilities over all augmentations (mapped back to the original frame).\n    Returns ranked attempts [best, runner-up], size source.\"\"\"\n    eps = [build_episode(item[\"support\"], item[\"q_in\"], None, a) for a in augs]\n    probs, nh, nw = run_model(m, eps)\n    h, w, src = infer_size(item[\"support\"], item[\"q_in\"].shape, (int(nh[0]), int(nw[0])))\n    total = np.zeros((10, h, w))\n    votes, grids = Counter(), {}\n    for p, (k, flip, perm) in zip(probs, augs):\n        th, tw = (h, w) if k % 2 == 0 else (w, h)\n        q = d4_inv(p[:, :th, :tw][perm], k, flip)             # back to original colours + orientation\n        total += q\n        g = q.argmax(0)\n        key = (g.shape, g.tobytes()); votes[key] += 1; grids[key] = g\n    avg = total.argmax(0)\n    ranked, avg_key = [avg], (avg.shape, avg.tobytes())\n    for key, _ in votes.most_common():\n        if key != avg_key:\n            ranked.append(grids[key]); break\n    return ranked, src\n\n\ndef test_time_train(pairs, steps, seed):\n    \"\"\"Fine-tune a fresh copy of the trained model on THIS task's demonstration pairs only\n    (leave-one-out episodes with random augmentation). Never touches the test input/output.\"\"\"\n    ttt_model.load_state_dict(BASE_STATE)\n    if steps <= 0 or len(pairs) < 2:\n        return ttt_model\n    opt = torch.optim.AdamW(ttt_model.parameters(), lr=CFG.ttt_lr, weight_decay=0.0)\n    sc = make_scaler()\n    rng = random.Random(seed)\n    ttt_model.train()\n    for _ in range(steps):\n        eps = []\n        for _ in range(CFG.ttt_batch):\n            qi = rng.randrange(len(pairs))\n            sup = [p for j, p in enumerate(pairs) if j != qi]\n            rng.shuffle(sup)\n            eps.append(build_episode(sup[:CFG.max_support_train], pairs[qi][0], pairs[qi][1], random_aug(rng)))\n        b = collate([episode_tensors(*e) for e in eps])\n        opt.zero_grad(set_to_none=True)\n        with torch.autocast(device_type=device.type, dtype=torch.float16, enabled=AMP):\n            out = ttt_model(b[\"support_inputs\"].to(device), b[\"support_outputs\"].to(device),\n                            b[\"query_input\"].to(device), b[\"support_mask\"].to(device))\n        loss, _, _ = compute_loss(out, b)\n        sc.scale(loss).backward(); sc.unscale_(opt)\n        nn.utils.clip_grad_norm_(ttt_model.parameters(), 1.0)\n        sc.step(opt); sc.update()\n    ttt_model.eval()\n    return ttt_model\n\n\ndef _same(a, b):\n    return b is not None and a.shape == b.shape and np.array_equal(a, b)\n\n\ndef solve_task_items(items, use_symbolic=True, use_ttt=True, use_tta=True, seed=SEED):\n    \"\"\"All items of one task (they share support pairs). Returns one result dict per item.\"\"\"\n    results = [None] * len(items)\n    need_neural = []\n    for i, it in enumerate(items):\n        if use_symbolic:\n            cands, status = symbolic_solve(it[\"support\"], it[\"q_in\"])\n            if cands:\n                results[i] = {\"attempts\": cands[:2], \"source\": \"symbolic\", \"detail\": status}\n                continue\n        need_neural.append(i)\n    if need_neural:\n        pairs = items[0][\"support\"]\n        m = test_time_train(pairs, CFG.ttt_steps, seed) if use_ttt else model\n        augs = make_tta_augs(CFG.tta_perms) if use_tta else [IDENTITY_AUG]\n        for i in need_neural:\n            ranked, src = predict_item(m, items[i], augs)\n            results[i] = {\"attempts\": ranked[:2], \"source\": \"neural\", \"detail\": src}\n    return results\n\n\ndef evaluate_pipeline(items, label, max_tasks=None, **kw):\n    by_task = {}\n    for it in items:\n        by_task.setdefault(it[\"task_id\"], []).append(it)\n    tids = list(by_task)[:max_tasks] if max_tasks else list(by_task)\n    n = p1 = p2 = sym_n = sym_ok = 0\n    t0 = time.time()\n    for tid in tids:\n        res = solve_task_items(by_task[tid], **kw)\n        for it, r in zip(by_task[tid], res):\n            n += 1\n            ok1 = _same(r[\"attempts\"][0], it[\"q_out\"])\n            ok2 = ok1 or (len(r[\"attempts\"]) > 1 and _same(r[\"attempts\"][1], it[\"q_out\"]))\n            p1 += ok1; p2 += ok2\n            if r[\"source\"] == \"symbolic\":\n                sym_n += 1; sym_ok += ok1\n    print(f\"[{label}] items {n} | pass@1 {p1/n:.1%} ({p1}) | pass@2 {p2/n:.1%} ({p2}) | \"\n          f\"symbolic used {sym_n} (correct {sym_ok}) | {(time.time()-t0)/60:.1f} min\")\n    return {\"pass1\": p1 / n, \"pass2\": p2 / n, \"n\": n}\n\nprint(\"Inference engine ready. TTA views per item:\", len(make_tta_augs(CFG.tta_perms)))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T06:38:36.47342Z","iopub.execute_input":"2026-11-07T06:38:36.473855Z","iopub.status.idle":"2026-11-07T06:38:36.537856Z","shell.execute_reply.started":"2026-11-07T06:38:36.473827Z","shell.execute_reply":"2026-11-07T06:38:36.536901Z"}},"outputs":[{"name":"stdout","text":"Inference engine ready. TTA views per item: 16\n","output_type":"stream"}],"execution_count":9},{"id":"d48e4bdf","cell_type":"markdown","source":"## 10. Validation ablation\nEach row adds one ingredient so you can see what actually helps. Reported on held-out **test pairs of validation tasks**.","metadata":{}},{"id":"d66efde1","cell_type":"code","source":"# 10. Validation: ablation table (each step is evaluated on the held-out TEST pairs of validation tasks)\nEVAL_MAX_TASKS = 5 if QUICK else 60        # set None to run every validation task (slower, esp. with TTT)\n\nprint(\"Single forward pass (no TTA / TTT / symbolic):\")\nm0 = evaluate_fast(model, val_loader, val_items)\nfor k, v in m0.items():\n    print(f\"  {k}: {v:.1%}\")\n\nr_a = evaluate_pipeline(val_items, \"neural only, no TTA\", max_tasks=EVAL_MAX_TASKS,\n                        use_symbolic=False, use_ttt=False, use_tta=False)\nr_b = evaluate_pipeline(val_items, \"neural + TTA\", max_tasks=EVAL_MAX_TASKS,\n                        use_symbolic=False, use_ttt=False, use_tta=True)\nr_c = evaluate_pipeline(val_items, \"neural + TTA + TTT\", max_tasks=EVAL_MAX_TASKS,\n                        use_symbolic=False, use_ttt=True, use_tta=True)\nr_d = evaluate_pipeline(val_items, \"FULL: symbolic -> neural + TTA + TTT\", max_tasks=EVAL_MAX_TASKS,\n                        use_symbolic=True, use_ttt=True, use_tta=True)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T06:38:36.540431Z","iopub.exec