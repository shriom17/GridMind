[\"support\"], it[\"q_in\"].shape, (nh, nw))\n        panels = [(\"support in\", it[\"support\"][0][0]), (\"support out\", it[\"support\"][0][1]), (\"query in\", it[\"q_in\"])]\n        panels += [(f\"step {t+1}\", out[\"logits\"][t][0].argmax(0).cpu().numpy()[:h, :w]) for t in range(CFG.steps)]\n        panels += [(\"target\", it[\"q_out\"])]\n        for c, (title, g) in enumerate(panels):\n            ax = axes[r, c]\n            ax.imshow(g, cmap=cmap, vmin=0, vmax=9)\n            ax.set_title(title if c else f\"{it['task_id'][:8]}\\n{title}\", fontsize=8)\n            ax.set_xticks([]); ax.set_yticks([])\n    plt.tight_layout(); plt.show()\n\nshow_refinement(val_items, count=4)\n\n# training curves\nif history:\n    ep = [h[\"epoch\"] for h in history]\n    fig, ax = plt.subplots(1, 3, figsize=(15, 4))\n    ax[0].plot(ep, [h[\"train_loss\"] for h in history]); ax[0].set_title(\"train loss\"); ax[0].grid(True)\n    ax[1].plot(ep, [h[\"changed_cell_acc\"] for h in history], label=\"changed-cell acc\")\n    ax[1].plot(ep, [h[\"cell_acc\"] for h in history], label=\"cell acc\"); ax[1].legend(); ax[1].grid(True)\n    ax[2].plot(ep, [h[\"exact_oracle_size\"] for h in history], label=\"exact (oracle size)\")\n    ax[2].plot(ep, [h[\"exact\"] for h in history], label=\"exact\"); ax[2].legend(); ax[2].grid(True)\n    plt.tight_layout(); plt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T06:44:32.957012Z","iopub.execute_input":"2026-11-07T06:44:32.957383Z","iopub.status.idle":"2026-11-07T06:44:34.790896Z","shell.execute_reply.started":"2026-11-07T06:44:32.957356Z","shell.execute_reply":"2026-11-07T06:44:34.790054Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1840x1000 with 32 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1500x400 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":11},{"id":"b693a308","cell_type":"markdown","source":"## 12. ARC-AGI-2 evaluation set and `submission.json`\nRuns the full pipeline on the 120 public evaluation tasks (this is the number that reflects real ARC-AGI-2 difficulty) and writes two attempts per test input.","metadata":{}},{"id":"eddb7648","cell_type":"code","source":"# 12. ARC-AGI-2 public evaluation set: real benchmark numbers + submission.json (2 attempts per test input)\nRUN_EVAL_SET = True\nEVAL_SET_MAX_TASKS = 3 if QUICK else None     # None = all 120 tasks\n\nif RUN_EVAL_SET and EVAL_TASKS:\n    eval_items = make_items(EVAL_TASKS, sorted(EVAL_TASKS))\n    by_task = {}\n    for it in eval_items:\n        by_task.setdefault(it[\"task_id\"], []).append(it)\n    tids = list(by_task)[:EVAL_SET_MAX_TASKS] if EVAL_SET_MAX_TASKS else list(by_task)\n    submission = {}\n    n = p1 = p2 = 0\n    has_gt = all(it[\"q_out\"] is not None for it in eval_items)\n    t0 = time.time()\n    for tid in tids:\n        res = solve_task_items(by_task[tid], use_symbolic=True, use_ttt=True, use_tta=True)\n        submission[tid] = []\n        for it, r in zip(by_task[tid], res):\n            a = [g.tolist() for g in r[\"attempts\"]]\n            if len(a) == 1:\n                a.append(a[0])\n            submission[tid].append({\"attempt_1\": a[0], \"attempt_2\": a[1]})\n            if has_gt:\n                n += 1\n                ok1 = _same(r[\"attempts\"][0], it[\"q_out\"])\n                ok2 = ok1 or (len(r[\"attempts\"]) > 1 and _same(r[\"attempts\"][1], it[\"q_out\"]))\n                p1 += ok1; p2 += ok2\n    path = os.path.join(OUT_DIR, \"submission.json\")\n    with open(path, \"w\") as f:\n        json.dump(submission, f)\n    print(\"Saved:\", path, \"| tasks:\", len(submission), f\"| {(time.time()-t0)/60:.1f} min\")\n    if has_gt and n:\n        print(f\"ARC-AGI-2 evaluation set  pass@1 {p1/n:.2%} ({p1}/{n}) | pass@2 {p2/n:.2%} ({p2}/{n})\")\nelse:\n    print(\"Evaluation set not available / skipped.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T06:44:34.792171Z","iopub.execute_input":"2026-11-07T06:44:34.792552Z","iopub.status.idle":"2026-11-07T06:50:23.765967Z","shell.execute_reply.started":"2026-11-07T06:44:34.792526Z","shell.execute_reply":"2026-11-07T06:50:23.765112Z"}},"outputs":[{"name":"stdout","text":"Saved: /kaggle/working/GridMind/outputs/submission.json | tasks: 120 | 5.8 min\nARC-AGI-2 evaluation set  pass@1 0.00% (0/167) | pass@2 0.00% (0/167)\n","output_type":"stream"}],"execution_count":12},{"id":"3fc43291","cell_type":"markdown","source":"## 13. ARC-AGI-1 check\nHow many ARC-AGI-1 tasks does the full pipeline solve? Reports *all* and *unseen* (not in this notebook's training split) separately, because ARC-AGI-2's training set overlaps with ARC-AGI-1.","metadata":{}},{"id":"164849e6","cell_type":"code","source":"# 13. ARC-AGI-1 evaluation (how many tasks does the full pipeline solve?)\n# NOTE: ARC-AGI-2's training set contains many ARC-AGI-1 tasks, so some ARC-1 tasks were SEEN in training.\n# We therefore report \"all\" and \"unseen\" (tasks whose content does not appear in this notebook's train split).\nARC1_SET = \"evaluation\"      # \"evaluation\" (400 tasks, harder) or \"training\" (400 tasks, mostly seen -> inflated)\nARC1_MAX_TASKS = 10 if QUICK else None   # None = all 400 tasks\nARC1_USE_TTT = True          # False = much faster (TTA only)\n\nARC1_DIR = os.path.join(os.path.dirname(PROJECT_DIR), \"ARC-AGI-1\")\nif not os.path.isdir(os.path.join(ARC1_DIR, \".git\")):\n    subprocess.run([\"git\", \"clone\", \"--depth\", \"1\", \"https://github.com/fchollet/ARC-AGI.git\", ARC1_DIR], check=True)\nARC1_TASKS = load_tasks(os.path.join(ARC1_DIR, \"data\", ARC1_SET))\nprint(\"ARC-AGI-1\", ARC1_SET, \"tasks:\", len(ARC1_TASKS))\n\n\ndef input_prints(t):\n    \"\"\"Hashes of every input grid of a task (train + test pairs).\"\"\"\n    grids = [a for a, _ in t[\"train\"]] + [a for a, _ in t[\"test\"]]\n    return {hash((g.shape, g.tobytes())) for g in grids}\n\n# Input grids of every task the model was actually trained on\nseen_prints = set()\nfor i in train_ids:\n    seen_prints |= input_prints(TRAIN_TASKS[i])\n# an ARC-1 task counts as SEEN if at least half of its input grids appear in the training split\narc1_seen = {tid for tid, t in ARC1_TASKS.items()\n             if len(input_prints(t) & seen_prints) >= 0.5 * len(input_prints(t))}\nprint(f\"ARC-1 tasks that also appear in this notebook's training split: {len(arc1_seen)} \"\n      f\"(unseen: {len(ARC1_TASKS) - len(arc1_seen)})\")\n\narc1_items = make_items(ARC1_TASKS, sorted(ARC1_TASKS))\nby_task = {}\nfor it in arc1_items:\n    by_task.setdefault(it[\"task_id\"], []).append(it)\ntids = list(by_task)[:ARC1_MAX_TASKS] if ARC1_MAX_TASKS else list(by_task)\n\nrows = []        # (task_id, n_inputs, n_solved@2, solved_by_symbolic, seen)\nt0 = time.time()\nfor k, tid in enumerate(tids):\n    res = solve_task_items(by_task[tid], use_symbolic=True, use_ttt=ARC1_USE_TTT, use_tta=True)\n    solved, sym = 0, 0\n    for it, r in zip(by_task[tid], res):\n        ok = any(_same(a, it[\"q_out\"]) for a in r[\"attempts\"][:2])\n        solved += ok\n        sym += ok and r[\"source\"] == \"symbolic\"\n    rows.append((tid, len(res), solved, sym, tid in arc1_seen))\n    if (k + 1) % 25 == 0:\n        print(f\"  {k+1}/{len(tids)} tasks | solved so far {sum(r[2] == r[1] for r in rows)} | {(time.time()-t0)/60:.1f} min\")\n\n\ndef summarize(sub, name):\n    if not sub:\n        print(f\"{name}: no tasks\"); return\n    n_tasks = len(sub)\n    full = sum(r[2] == r[1] for r in sub)                       # every test input right (strict)\n    score = sum(r[2] / r[1] for r in sub) / n_tasks             # official-style partial credit per task\n    by_sym = sum(r[2] == r[1] and r[3] == r[1] for r in sub)\n    print(f\"{name:<8} tasks {n_tasks:>3} | fully solved {full:>3} ({full/n_tasks:.1%}) | \"\n          f\"ARC score (pass@2, per-task avg) {score:.1%} | of which symbolic-only {by_sym}\")\n\nprint(\"\\n=== ARC-AGI-1\", ARC1_SET, \"| TTT:\", ARC1_USE_TTT, \"|\", f\"{(time.time()-t0)/60:.1f} min\", \"===\")\nsummarize(rows, \"ALL\")\nsummarize([r for r in rows if not r[4]], \"UNSEEN\")\nsummarize([r for r in rows if r[4]], \"SEEN\")\nprint(\"Trust the UNSEEN line: SEEN tasks were (partly) in the training split.\")\nsolved_ids = [r[0] for r in rows if r[2] == r[1]]\nprint(\"Fully solved task ids:\", solved_ids[:40])\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T06:50:23.767239Z","iopub.execute_input":"2026-11-07T06:50:23.76758Z","iopub.status.idle":"2026-11-07T07:08:29.888619Z","shell.execute_reply.started":"2026-11-07T06:50:23.767548Z","shell.execute_reply":"2026-11-07T07:08:29.887658Z"}},"outputs":[{"name":"stderr","text":"Cloning into '/kaggle/working/ARC-AGI-1'...\n","output_type":"stream"},{"name":"stdout","text":"ARC-AGI-1 evaluation tasks: 400\nARC-1 tasks that also appear in this notebook's training split: 306 (unseen: 94)\n  25/400 tasks | solved so far 2 | 1.0 min\n  50/400 tasks | solved so far 3 | 2.1 min\n  75/400 tasks | solved so far 3 | 3.4 min\n  100/400 tasks | solved so far 5 | 4.6 min\n  125/400 tasks | solved so far 6 | 5.8 min\n  150/400 tasks | solved so far 9 | 6.8 min\n  175/400 tasks | solved so far 11 | 7.9 min\n  200/400 tasks | solved so far 13 | 9.0 min\n  225/400 tasks | solved so far 14 | 10.2 min\n  250/400 tasks | solved so far 14 | 11.4 min\n  275/400 tasks | solved so far 14 | 12.5 min\n  300/400 tasks | solved so far 15 | 13.7 min\n  325/400 tasks | solved so far 16 | 14.8 min\n  350/400 tasks | solved so far 18 | 15.8 min\n  375/400 tasks | solved so far 18 | 16.9 min\n  400/400 tasks | solved so far 18 | 18.1 min\n\n=== ARC-AGI-1 evaluation | TTT: True | 18.1 min ===\nALL      tasks 400 | fully solved  18 (4.5%) | ARC score (pass@2, per-task avg) 4.5% | of which symbolic-only 16\nUNSEEN   tasks  94 | fully solved   2 (2.1%) | ARC score (pass@2, per-task avg) 2.1% | of which symbolic-only 1\nSE