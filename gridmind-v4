{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.13.16","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"b9c6f53a","cell_type":"markdown","source":"# GridMind V4 — Relation-Aware Multi-Scale Reasoning\n\n**Clean notebook based on GridMind V3.** This notebook keeps the V3 task setup, 30×30 padded grids, episodic support/query training, 2D positional information, Transformer cross-attention, and high-resolution decoder.\n\n## What changes in V4\n1. **Explicit support transformation features:** encode each support input and output, then construct a learned relation representation from `[input, output, output − input]`.\n2. **Multi-scale query decoding:** retain V3's high-resolution CNN skip features and add a residual refinement decoder.\n3. **Hybrid size inference:** at evaluation/inference, use a support-derived height/width ratio when the support examples agree; otherwise fall back to the learned size head.\n\nThis is an experiment, not a guaranteed improvement. The hybrid size rule uses support examples and query-input dimensions only; it never reads query target dimensions to make predictions.","metadata":{}},{"id":"eea16e54","cell_type":"code","source":"# 1. Imports and reproducibility\nimport os\nimport json\nimport math\nimport random\nimport subprocess\nimport platform\nfrom pathlib import Path\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom matplotlib.colors import ListedColormap\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\nfrom sklearn.model_selection import train_test_split\n\nSEED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\n\nif torch.cuda.is_available():\n    torch.cuda.manual_seed_all(SEED)\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"Python:\", platform.python_version())\nprint(\"PyTorch:\", torch.__version__)\nprint(\"CUDA:\", torch.cuda.is_available())\nif torch.cuda.is_available():\n    print(\"GPU:\", torch.cuda.get_device_name(0))\nprint(\"Device:\", device)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T04:31:31.582636Z","iopub.execute_input":"2026-11-07T04:31:31.583291Z","iopub.status.idle":"2026-11-07T04:31:39.913999Z","shell.execute_reply.started":"2026-11-07T04:31:31.583265Z","shell.execute_reply":"2026-11-07T04:31:39.91319Z"}},"outputs":[{"name":"stdout","text":"Python: 3.13.16\nPyTorch: 2.11.0+cu130\nCUDA: True\nGPU: Tesla T4\nDevice: cuda\n","output_type":"stream"}],"execution_count":1},{"id":"287f8468","cell_type":"code","source":"# 2. Download ARC-AGI-2 training data\nREPO_URL = \"https://github.com/arcprize/ARC-AGI-2.git\"\nPROJECT_DIR = \"/kaggle/working/GridMind\"\nDATA_DIR = os.path.join(PROJECT_DIR, \"data\")\n\nif not os.path.isdir(os.path.join(PROJECT_DIR, \".git\")):\n    if os.path.exists(PROJECT_DIR) and os.listdir(PROJECT_DIR):\n        raise RuntimeError(\n            f\"{PROJECT_DIR} exists but is not an ARC-AGI-2 git checkout. \"\n            \"Change PROJECT_DIR to a new empty folder.\"\n        )\n    subprocess.run(\n        [\"git\", \"clone\", \"--depth\", \"1\", REPO_URL, PROJECT_DIR],\n        check=True\n    )\n\nTRAIN_DIR = os.path.join(DATA_DIR, \"training\")\nEVAL_DIR = os.path.join(DATA_DIR, \"evaluation\")\n\nassert os.path.isdir(TRAIN_DIR), f\"Training directory not found: {TRAIN_DIR}\"\n\ntrain_files = sorted(f for f in os.listdir(TRAIN_DIR) if f.endswith(\".json\"))\neval_files = sorted(f for f in os.listdir(EVAL_DIR) if f.endswith(\".json\")) if os.path.isdir(EVAL_DIR) else []\n\nos.makedirs(os.path.join(PROJECT_DIR, \"checkpoints\"), exist_ok=True)\nos.makedirs(os.path.join(PROJECT_DIR, \"outputs\"), exist_ok=True)\n\nprint(\"Training tasks:\", len(train_files))\nprint(\"Evaluation tasks:\", len(eval_files))\nprint(\"Training directory:\", TRAIN_DIR)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T04:31:39.915213Z","iopub.execute_input":"2026-11-07T04:31:39.915981Z","iopub.status.idle":"2026-11-07T04:31:40.837654Z","shell.execute_reply.started":"2026-11-07T04:31:39.915946Z","shell.execute_reply":"2026-11-07T04:31:40.836954Z"}},"outputs":[{"name":"stderr","text":"Cloning into '/kaggle/working/GridMind'...\n","output_type":"stream"},{"name":"stdout","text":"Training tasks: 1000\nEvaluation tasks: 120\nTraining directory: /kaggle/working/GridMind/data/training\n","output_type":"stream"}],"execution_count":2},{"id":"5a03cfbe","cell_type":"markdown","source":"## Data representation\n\nEvery grid is padded to 30×30. Channels 0–9 are one-hot colours and channel 10 is the valid-cell mask. The target uses `-100` for padded cells so those cells do not contribute to colour loss.","metadata":{}},{"id":"a3e09c9c","cell_type":"code","source":"# 3. Grid encoding\nGRID_SIZE = 30\nNUM_CHANNELS = 11\nNUM_COLORS = 10\n\ndef encode_grid(grid):\n    grid = np.asarray(grid, dtype=np.int64)\n    h, w = grid.shape\n\n    if h > GRID_SIZE or w > GRID_SIZE:\n        raise ValueError(f\"Grid {h}x{w} exceeds {GRID_SIZE}x{GRID_SIZE}\")\n\n    encoded = np.zeros((NUM_CHANNELS, GRID_SIZE, GRID_SIZE), dtype=np.float32)\n    for color in range(NUM_COLORS):\n        encoded[color, :h, :w] = (grid == color)\n    encoded[10, :h, :w] = 1.0\n\n    return torch.from_numpy(encoded), h, w\n\n\ndef encode_target(grid):\n    grid = np.asarray(grid, dtype=np.int64)\n    h, w = grid.shape\n\n    if h > GRID_SIZE or w > GRID_SIZE:\n        raise ValueError(f\"Grid {h}x{w} exceeds {GRID_SIZE}x{GRID_SIZE}\")\n\n    target = torch.full((GRID_SIZE, GRID_SIZE), -100, dtype=torch.long)\n    target[:h, :w] = torch.as_tensor(grid, dtype=torch.long)\n    return target, h, w\n\n\nARC_COLORS = [\n    \"#000000\", \"#0074D9\", \"#FF4136\", \"#2ECC40\", \"#FFDC00\",\n    \"#AAAAAA\", \"#F012BE\", \"#FF851B\", \"#7FDBFF\", \"#870C25\"\n]\ncmap = ListedColormap(ARC_COLORS)\n\nprint(\"Grid encoding ready.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T04:31:40.838547Z","iopub.execute_input":"2026-11-07T04:31:40.838848Z","iopub.status.idle":"2026-11-07T04:31:40.846331Z","shell.execute_reply.started":"2026-11-07T04:31:40.838827Z","shell.execute_reply":"2026-11-07T04:31:40.845612Z"}},"outputs":[{"name":"stdout","text":"Grid encoding ready.\n","output_type":"stream"}],"execution_count":3},{"id":"042372d8","cell_type":"code","source":"# 4. Task-level train/validation split\ntask_ids = sorted(os.path.splitext(f)[0] for f in train_files)\n\ntrain_ids, val_ids = train_test_split(\n    task_ids,\n    test_size=0.20,\n    random_state=SEED\n)\n\nsplit_path = os.path.join(PROJECT_DIR, \"task_split_v4.json\")\nwith open(split_path, \"w\") as f:\n    json.dump(\n        {\"train_ids\": sorted(train_ids), \"val_ids\": sorted(val_ids), \"seed\": SEED},\n        f,\n        indent=2\n    )\n\nprint(\"Train tasks:\", len(train_ids))\nprint(\"Validation tasks:\", len(val_ids))\nprint(\"Split saved:\", split_path)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T04:31:40.848109Z","iopub.execute_input":"2026-11-07T04:31:40.848552Z","iopub.status.idle":"2026-11-07T04:31:40.898275Z","shell.execute_reply.started":"2026-11-07T04:31:40.84851Z","shell.execute_reply":"2026-11-07T04:31:40.897749Z"}},"outputs":[{"name":"stdout","text":"Train tasks: 800\nValidation tasks: 200\nSplit saved: /kaggle/working/GridMind/task_split_v4.json\n","output_type":"stream"}],"execution_count":4},{"id":"c5f8ab58","cell_type":"code","source":"# 5. Episodic dataset\nclass GridMindDataset(Dataset):\n    def __init__(self, task_ids, data_dir, seed=42):\n        self.task_ids = list(task_ids)\n        self.data_dir = data_dir\n        self.seed = seed\n        self.epoch = 0\n\n    def set_epoch(self, epoch):\n        self.epoch = int(epoch)\n\n    def __len__(self):\n        return len(self.task_ids)\n\n    def __getitem__(self, idx):\n        task_id = self.task_ids[idx]\n        path = os.path.join(self.data_dir, task_id + \".json\")\n\n        with open(path, \"r\") as f:\n            task = json.load(f)\n\n        examples = task[\"train\"]\n        if len(examples) < 2:\n            raise ValueError(f\"Task {task_id} needs at least 2 train examples\")\n\n        # Deterministic query selection for each task and epoch.\n        rng = random.Random(self.seed + self.epoch * 100003 + idx)\n        query_idx = rng.randrange(len(examples))\n        query_example = examples[query_idx]\n        support_examples = [ex for i, ex in enumerate(examples) if i != query_idx]\n\n        support_inputs, support_outputs = [], []\n        for ex in support_examples:\n            sx, _, _ = encode_grid(ex[\"input\"])\n            sy, _, _ = encode_grid(ex[\"output\"])\n            support_inputs.append(sx)\n            support_outputs.append(sy)\n\n        query_input, qh, qw = encode_grid(query_example[\"input\"])\n        query_target, th, tw = encode_target(query_example[\"output\"])\n\n        return {\n            \"support_inputs\": torch.stack(support_inputs),\n            \"support_outputs\": torch.stack(support_outputs),\n            \"query_input\": query_input,\n            \"query_target\": query_target,\n            \"query_size\": torch.tensor([qh, qw], dtype=torch.long),\n            \"target_size\": torch.tensor([th, tw], dtype=torch.long),\n            \"task_id\": task_id\n        }\n\n\ndef gridmind_collate(batch):\n    batch_size = len(batch)\n    max_support = max(item[\"support_inputs\"].shape[0] for item in batch)\n\n    support_inputs = torch.zeros(batch_size, max_support, NUM_CHANNELS, GRID_SIZE, GRID_SIZE)\n    support_outputs = torch.zeros_like(support_inputs)\n    support_mask = torch.zeros(batch_size, max_support, dtype=torch.bool)\n\n    for i, item in enumerate(batch):\n        n = item[\"support_inputs\"].shape[0]\n        support_inputs[i, :n] = item[\"support_inputs\"]\n        support_outputs[i, :n] = item[\"support_outputs\"]\n        support_mask[i, :n] = True\n\n    return {\n        \"support_inputs\": support_inputs,\n        \"support_outputs\": support_outputs,\n        \"support_mask\": support_mask,\n        \"query_input\": torch.stack([x[\"query_input\"] for x in batch]),\n        \"query_target\": torch.stack([x[\"query_target\"] for x in batch]),\n        \"query_size\": torch.stack([x[\"query_size\"] for x in batch]),\n        \"target_size\": torch.stack([x[\"target_size\"] for x in batch]),\n        \"task_id\": [x[\"task_id\"] for x in batch]\n    }\n\nprint(\"Dataset and collate function ready.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T04:31:40.899207Z","iopub.execute_input":"2026-11-07T04:31:40.899517Z","iopub.status.idle":"2026-11-07T04:31:40.915757Z","shell.execute_reply.started":"2026-11-07T04:31:40.899488Z","shell.execute_reply":"2026-11-07T04:31:40.915088Z"}},"outputs":[{"name":"stdout","text":"Dataset and collate function ready.\n","output_type":"stream"}],"execution_count":5},{"id":"dd1c423e","cell_type":"code","source":"# 6. DataLoaders\nBATCH_SIZE = 2  # Increase to 4 only if GPU memory permits.\n\ntrain_dataset = GridMindDataset(train_ids, TRAIN_DIR, seed=42)\nval_dataset = GridMindDataset(val_ids, TRAIN_DIR, seed=1000)\nval_dataset.set_epoch(0)  # Fixed validation query episode.\n\ntrain_loader = DataLoader(\n    train_dataset, batch_size=BATCH_SIZE, shuffle=True,\n    collate_fn=gridmind_collate, num_workers=0, pin_memory=torch.cuda.is_available()\n)\nval_loader = DataLoader(\n    val_dataset, batch_size=BATCH_SIZE, shuffle=False,\n    collate_fn=gridmind_collate, num_workers=0, pin_memory=torch.cuda.is_available()\n)\n\nprint(\"Train batches:\", len(train_loader))\nprint(\"Validation batches:\", len(val_loader))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T04:31:40.916538Z","iopub.execute_input":"2026-11-07T04:31:40.916793Z","iopub.status.idle":"2026-11-07T04:31:40.936774Z","shell.execute_reply.started":"2026-11-07T04:31:40.916774Z","shell.execute_reply":"2026-11-07T04:31:40.935859Z"}},"outputs":[{"name":"stdout","text":"Train batches: 400\nValidation batches: 100\n","output_type":"stream"}],"execution_count":6},{"id":"48c6bb79","cell_type":"code","source":"# 7. V4 configuration\nclass GridMindV4Config:\n    grid_size = 30\n    low_grid_size = 15\n    input_channels = 11\n    num_colors = 10\n\n    hidden_dim = 128\n    num_heads = 4\n    num_transformer_layers = 4\n    dropout = 0.1\n    max_support_pairs = 10\n\nconfig = GridMindV4Config()\nprint(\"GridMind V4 config ready.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T04:31:40.937876Z","iopub.execute_input":"2026-11-07T04:31:40.938143Z","iopub.status.idle":"2026-11-07T04:31:40.951158Z","shell.execute_reply.started":"2026-11-07T04:31:40.938117Z","shell.execute_reply":"2026-11-07T04:31:40.950539Z"}},"outputs":[{"name":"stdout","text":"GridMind V4 config ready.\n","output_type":"stream"}],"execution_count":7},{"id":"d401520b","cell_type":"markdown","source":"## V4 architecture\n\nV4 retains V3's high-resolution CNN path, 2D row/column embeddings, support-pair identity, Transformer decoder cross-attention, and output colour/size heads.\n\nThe main change is the **explicit relation representation**. For each support pair, V4 learns a token representation from the encoded input, encoded output, and their feature difference. The Transformer can attend to both the original support input and this transformation representation.","metadata":{}},{"id":"f6a3a787","cell_type":"code","source":"# 8. V4 encoder and 2D positional embeddings\nclass ConvResidualBlock(nn.Module):\n    def __init__(self, channels, dropout=0.0):\n        super().__init__()\n        self.block = nn.Sequential(\n            nn.Conv2d(channels, channels, 3, padding=1, bias=False),\n            nn.GroupNorm(8, channels),\n            nn.GELU(),\n            nn.Dropout2d(dropout),\n            nn.Conv2d(channels, channels, 3, padding=1, bias=False),\n            nn.GroupNorm(8, channels)\n        )\n        self.act = nn.GELU()\n\n    def forward(self, x):\n        return self.act(x + self.block(x))\n\n\nclass GridEncoderV4(nn.Module):\n    def __init__(self, config):\n        super().__init__()\n        self.high_encoder = nn.Sequential(\n            nn.Conv2d(config.input_channels, 64, 3, padding=1, bias=False),\n            nn.GroupNorm(8, 64),\n            nn.GELU(),\n            nn.Conv2d(64, 64, 3, padding=1, bias=False),\n            nn.GroupNorm(8, 64),\n            nn.GELU(),\n            ConvResidualBlock(64, config.dropout)\n        )\n        self.downsample = nn.Sequential(\n            nn.Conv2d(64, 96, 3, stride=2, padding=1, bias=False),\n            nn.GroupNorm(8, 96),\n            nn.GELU(),\n            nn.Conv2d(96, config.hidden_dim, 3, padding=1, bias=False),\n            nn.GroupNorm(8, config.hidden_dim),\n            nn.GELU()\n        )\n\n    def forward(self, x):\n        high = self.high_encoder(x)\n        low = self.downsample(high)\n        return high, low\n\n\nclass PositionalEmbedding2D(nn.Module):\n    def __init__(self, dim, grid_size):\n        super().__init__()\n        self.row_embedding = nn.Parameter(torch.randn(1, grid_size, 1, dim) * 0.02)\n        self.col_embedding = nn.Parameter(torch.randn(1, 1, grid_size, dim) * 0.02)\n\n    def forward(self, x):\n        return x + self.row_embedding + self.col_embedding","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T04:31:40.952205Z","iopub.execute_input":"2026-11-07T04:31:40.952547Z","iopub.status.idle":"2026-11-07T04:31:40.965615Z","shell.execute_reply.started":"2026-11-07T04:31:40.952526Z","shell.execute_reply":"2026-11-07T04:31:40.964937Z"}},"outputs":[],"execution_count":8},{"id":"4e043499","cell_type":"code","source":"# 9. GridMind V4 model\nclass GridMindV4(nn.Module):\n    def __init__(self, config):\n        super().__init__()\n        self.config = config\n        d = config.hidden_dim\n        g = config.grid_size\n        low_g = config.low_grid_size\n\n        self.encoder = GridEncoderV4(config)\n        self.position_embedding = PositionalEmbedding2D(d, low_g)\n\n        # Roles: support input, support relation, query.\n        self.role_embedding = nn.Parameter(torch.randn(1, 3, 1, d) * 0.02)\n        self.pair_embedding = nn.Parameter(\n            torch.randn(1, config.max_support_pairs, 1, d) * 0.02\n        )\n\n        # Explicit learned support transformation representation.\n        self.relation_encoder = nn.Sequential(\n            nn.Linear(3 * d, 2 * d),\n            nn.GELU(),\n            nn.Dropout(config.dropout),\n            nn.Linear(2 * d, d),\n            nn.LayerNorm(d)\n        )\n\n        decoder_layer = nn.TransformerDecoderLayer(\n            d_model=d,\n            nhead=config.num_heads,\n            dim_feedforward=4 * d,\n            dropout=config.dropout,\n            batch_first=True,\n            norm_first=True,\n            activation=\"gelu\"\n        )\n        self.reasoner = nn.TransformerDecoder(\n            decoder_layer, num_layers=config.num_transformer_layers\n        )\n        self.reasoning_norm = nn.LayerNorm(d)\n\n        self.grid_fusion = nn.Sequential(\n            nn.Conv2d(d + 64 + config.input_channels, 128, 3, padding=1, bias=False),\n            nn.GroupNorm(8, 128),\n            nn.GELU(),\n            ConvResidualBlock(128, config.dropout),\n            nn.Conv2d(128, 96, 3, padding=1, bias=False),\n            nn.GroupNorm(8, 96),\n            nn.GELU(),\n            ConvResidualBlock(96, config.dropout),\n            nn.Conv2d(96, config.num_colors, 1)\n        )\n\n        self.size_head = nn.Sequential(\n            nn.Linear(2 * d, d),\n            nn.GELU(),\n            nn.Dropout(config.dropout),\n            nn.Linear(d, 2 * g)\n        )\n\n    def encode(self, x):\n        high, low = self.encoder(x)\n        b, d, h, w = low.shape\n        tokens = low.flatten(2).transpose(1, 2).reshape(\n            b, self.config.low_grid_size, self.config.low_grid_size, d\n        )\n        tokens = self.position_embedding(tokens)\n        return high, tokens.reshape(b, h * w, d)\n\n    def spatial_mask(self, x):\n        # 30x30 valid mask -> 15x15 token mask.\n        mask = F.max_pool2d(x[:, 10:11], kernel_size=2, stride=2)\n        return mask.flatten(1) > 0\n\n    def forward(self, support_inputs, support_outputs, query_input, support_mask):\n        b, s, c, h, w = support_inputs.shape\n        if s > self.config.max_support_pairs:\n            raise ValueError(\n                f\"Received {s} support pairs; config limit is {self.config.max_support_pairs}\"\n            )\n\n        sx = support_inputs.reshape(b * s, c, h, w)\n        sy = support_outputs.reshape(b * s, c, h, w)\n\n        _, sx_tokens = self.encode(sx)\n        _, sy_tokens = self.encode(sy)\n\n        sx_tokens = sx_tokens.reshape(b, s, -1, self.config.hidden_dim)\n        sy_tokens = sy_tokens.reshape(b, s, -1, self.config.hidden_dim)\n\n        pair_emb = self.pair_embedding[:, :s]\n        input_tokens = sx_tokens + self.role_embedding[:, 0] + pair_emb\n\n        relation_input = torch.cat(\n            [sx_tokens, sy_tokens, sy_tokens - sx_tokens], dim=-1\n        )\n        relation_tokens = self.relation_encoder(relation_input)\n        relation_tokens = relation_tokens + self.role_embedding[:, 1] + pair_emb\n\n        # Memory per support pair: input tokens + learned relation tokens.\n        memory = torch.cat([input_tokens, relation_tokens], dim=2)\n        memory = memory.reshape(b, s * 2 * 225, self.config.hidden_dim)\n\n        input_mask = self.spatial_mask(sx).reshape(b, s, 225)\n        output_mask = self.spatial_mask(sy).reshape(b, s, 225)\n        relation_mask = input_mask | output_mask\n        memory_mask = torch.cat([input_mask, relation_mask], dim=2)\n        memory_mask = memory_mask & support_mask.unsqueeze(-1)\n        memory_mask = memory_mask.reshape(b, s * 450)\n\n        query_high, query_tokens = self.encode(query_input)\n        query_tokens = query_tokens + self.role_embedding[:, 2]\n        query_mask = self.spatial_mask(query_input)\n\n        reasoning = self.reasoner(\n            tgt=query_tokens,\n            memory=memory,\n            tgt_key_padding_mask=~query_mask,\n            memory_key_padding_mask=~memory_mask\n        )\n        reasoning = self.reasoning_norm(reasoning)\n\n        spatial = reasoning.transpose(1, 2).reshape(\n            b, self.config.hidden_dim,\n            self.config.low_grid_size, self.config.low_grid_size\n        )\n        spatial = F.interpolate(\n            spatial, size=(self.config.grid_size, self.config.grid_size),\n            mode=\"bilinear\", align_corners=False\n        )\n\n        decoder_input = torch.cat([spatial, query_high, query_input], dim=1)\n        colour_logits = self.grid_fusion(decoder_input)\n\n        valid = query_mask.unsqueeze(-1).float()\n        denom = valid.sum(dim=1).clamp(min=1.0)\n        query_pooled = (query_tokens * valid).sum(dim=1) / denom\n        reasoning_pooled = (reasoning * valid).sum(dim=1) / denom\n        size_logits = self.size_head(torch.cat([query_pooled, reasoning_pooled], dim=-1))\n\n        return {\n            \"colour_logits\": colour_logits,\n            \"height_logits\": size_logits[:, :self.config.grid_size],\n            \"width_logits\": size_logits[:, self.config.grid_size:]\n        }\n\nprint(\"GridMind V4 architecture defined.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T04:31:40.966738Z","iopub.