\"epoch\"] for x in history]\ntrain_losses = [x[\"train_loss\"] for x in history]\nval_losses = [x[\"loss\"] for x in history]\n\nplt.figure(figsize=(9, 5))\nplt.plot(epochs_ran, train_losses, label=\"Training loss\")\nplt.plot(epochs_ran, val_losses, label=\"Validation loss\")\nplt.xlabel(\"Epoch\")\nplt.ylabel(\"Loss\")\nplt.title(\"GridMind V4 — Training vs Validation Loss\")\nplt.legend()\nplt.grid(True)\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T04:40:39.79892Z","iopub.execute_input":"2026-11-07T04:40:39.799217Z","iopub.status.idle":"2026-11-07T04:40:40.024474Z","shell.execute_reply.started":"2026-11-07T04:40:39.799196Z","shell.execute_reply":"2026-11-07T04:40:40.023708Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 900x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":17},{"id":"f8017fa3-6ca1-4fe7-a7ac-58ad5485958f","cell_type":"code","source":"\nimport numpy as np\n\n# 1. Decode a padded 11-channel grid into its original dimensions.\ndef decode_valid_grid(encoded):\n    if torch.is_tensor(encoded):\n        encoded = encoded.detach().cpu().numpy()\n\n    valid = encoded[10] > 0.5\n    h = int(valid.any(axis=1).sum())\n    w = int(valid.any(axis=0).sum())\n\n    if h == 0 or w == 0:\n        return None\n\n    return encoded[:10, :h, :w].argmax(axis=0).astype(np.int64)\n\n\n# 2. Generate the eight dihedral transformations.\ndef get_d4_variants(grid):\n    variants = []\n\n    for k in range(4):\n        rotated = np.rot90(grid, k)\n        variants.append((f\"rot{k * 90}\", rotated.copy()))\n        variants.append((f\"flip_rot{k * 90}\",\n                         np.fliplr(rotated).copy()))\n\n    return variants\n\n\n# 3. Infer a single consistent colour mapping.\ndef infer_colour_mapping(src, dst, mapping):\n    if src.shape != dst.shape:\n        return False\n\n    for a, b in zip(src.flatten(), dst.flatten()):\n        a, b = int(a), int(b)\n\n        if a in mapping and mapping[a] != b:\n            return False\n\n        mapping[a] = b\n\n    return True\n\n\ndef apply_colour_mapping(grid, mapping):\n    result = np.full(grid.shape, -1, dtype=np.int64)\n\n    for colour, target_colour in mapping.items():\n        result[grid == colour] = target_colour\n\n    if (result < 0).any():\n        return None\n\n    return result\n\n\n# 4. Find transformations that solve EVERY support pair.\ndef support_verified_solver(support_inputs,\n                            support_outputs,\n                            support_mask,\n                            query_input):\n\n    support_pairs = []\n\n    for j in range(len(support_mask)):\n        if not bool(support_mask[j]):\n            continue\n\n        src = decode_valid_grid(support_inputs[j])\n        dst = decode_valid_grid(support_outputs[j])\n\n        if src is None or dst is None:\n            continue\n\n        support_pairs.append((src, dst))\n\n    if not support_pairs:\n        return None, \"no_support\"\n\n    query = decode_valid_grid(query_input)\n\n    if query is None:\n        return None, \"invalid_query\"\n\n    valid_candidates = {}\n\n    for transform_name, _ in get_d4_variants(\n        support_pairs[0][0]\n    ):\n        mapping = {}\n        valid = True\n\n        for src, dst in support_pairs:\n            variants = dict(get_d4_variants(src))\n\n            transformed = variants[transform_name]\n\n            if transformed.shape != dst.shape:\n                valid = False\n                break\n\n            if not infer_colour_mapping(\n                transformed, dst, mapping\n            ):\n                valid = False\n                break\n\n        if not valid:\n            continue\n\n        # Verify the complete support set again.\n        for src, dst in support_pairs:\n            transformed = dict(\n                get_d4_variants(src)\n            )[transform_name]\n\n            predicted = apply_colour_mapping(\n                transformed, mapping\n            )\n\n            if predicted is None or not np.array_equal(\n                predicted, dst\n            ):\n                valid = False\n                break\n\n        if not valid:\n            continue\n\n        query_variants = dict(get_d4_variants(query))\n        transformed_query = query_variants[transform_name]\n\n        candidate = apply_colour_mapping(\n            transformed_query, mapping\n        )\n\n        if candidate is not None:\n            key = (candidate.shape, candidate.tobytes())\n            valid_candidates[key] = candidate\n\n    # Accept only when all valid rules agree on the query output.\n    if len(valid_candidates) == 1:\n        return next(iter(valid_candidates.values())), \"symbolic\"\n\n    if len(valid_candidates) > 1:\n        return None, \"ambiguous\"\n\n    return None, \"no_rule\"\n\n\nprint(\"Support-verified symbolic solver ready.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-07T04:45:29.736535Z","iopub.execute_input":"2026-11-07T04:45:29.736854Z","iopub.status.idle":"2026-11-07T04:45:29.752057Z","shell.execute_reply.started":"2026-11-07T04:45:29.736829Z","shell.execute_reply":"2026-11-07T04:45:29.751443Z"}},"outputs":[{"name":"stdout","text":"Support-verified symbolic solver ready.\n","output_type":"stream"}],"execution_count":20},{"id":"5a773cf5-a8bc-4131-bbac-533b307f7c4b","cell_type":"code","source":"\n@torch.no_grad()\ndef evaluate_v4_symbolic_hybrid(model, loader):\n    model.eval()\n\n    correct_cells = 0\n    total_cells = 0\n    exact_matches = 0\n    total_tasks = 0\n\n    symbolic_used = 0\n    neural_used = 0\n    ambiguous = 0\n\n    for batch in loader:\n        predictions = model(\n            batch[\"support_inputs\"].to(device),\n            batch[\"support_outputs\"].to(device),\n            batch[\"query_input\"].to(device),\n            batch[\"support_mask\"].to(device)\n        )\n\n        colour_pred = (\n            pre